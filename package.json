{
  "name": "react-advanced-texteditor-md",
  "version": "0.3.1",
  "description": "React bindings for advanced-texteditor-md: a WYSIWYG editor that stores Markdown. A controlled or uncontrolled <MarkdownEditor />, a native <MarkdownView /> renderer (server-component friendly), and hooks. Mentions, chips, uploads, plugins, themes.",
  "keywords": [
    "app router",
    "chips",
    "contenteditable",
    "gfm",
    "hooks",
    "latex",
    "markdown",
    "markdown editor",
    "markdown editor component",
    "markdown renderer",
    "markdown-wysiwyg",
    "mention",
    "mentions",
    "next.js",
    "next.js markdown editor",
    "nextjs",
    "react",
    "react component",
    "react editor",
    "react markdown editor",
    "react markdown renderer",
    "react rich text editor",
    "react server components",
    "react wysiwyg",
    "server components",
    "ssr",
    "tailwind",
    "typescript",
    "wysiwyg",
    "wysiwyg markdown"
  ],
  "homepage": "https://faraasat.github.io/react-advanced-texteditor-md",
  "bugs": {
    "url": "https://github.com/faraasat/react-advanced-texteditor-md/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraasat/react-advanced-texteditor-md.git"
  },
  "license": "MIT",
  "author": "Farasat Ali <63093876+faraasat@users.noreply.github.com>",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/faraasat"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./view": {
      "import": {
        "types": "./dist/view.d.mts",
        "default": "./dist/view.mjs"
      },
      "require": {
        "types": "./dist/view.d.ts",
        "default": "./dist/view.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "view": [
        "./dist/view.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:example": "tsc --noEmit -p example/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/size.mjs",
    "check:next": "node scripts/check-next-compat.mjs",
    "link:core": "npm install --no-save ../advanced-texteditor-md",
    "example:build": "node example/build.mjs",
    "test:e2e": "npm run build && npm run example:build && playwright test",
    "release": "standard-version",
    "prepublishOnly": "npm run typecheck && vitest run && npm run build && npm run typecheck:example && npm run size && npm run check:next",
    "site:install": "node scripts/site-install.mjs",
    "site:build": "node scripts/site-build.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "site:screenshots": "node scripts/site-screenshots.mjs",
    "test:site": "playwright test -c playwright.site.config.ts"
  },
  "dependencies": {
    "advanced-texteditor-md": "^0.3.1"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "standard-version": "^9.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
